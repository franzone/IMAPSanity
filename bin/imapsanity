#!/bin/sh
# Runs IMAPSanity v2 with the first Python >= 3.11 found (stdlib only, no venv needed).
DIR="$(cd "$(dirname "$0")/.." && pwd)"
for py in python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m imapsanity "$@"
  fi
done
echo "imapsanity: needs Python >= 3.11" >&2
exit 1
